  "scenarios": [
    {
      "id": "write-denied",
      "cli": {
        "argv": [
          "commit",
          "--repo",
          "<repo>",
          "--path",
          "a.txt",
          "--message",
          "Selected paths",
          "--output-budget",
          "65536"
        ],
        "expectedExit": 21,
        "expectedError": "denied",
        "cancellation": "none"
      },
      "mcpTool": "agent_commit",
      "mcpConfiguration": "conflicted-git",
      "mcpArguments": {
        "paths": [
          "a.txt"
        ],
        "message": "Selected paths"
      },
      "mcpTransportOutcome": "call-tool-result",
      "operation": "commit",
      "status": "error",
      "terminal": true,
      "errorCode": "denied",
      "expectedExit": 21
    },
    {
      "id": "unsupported-forge",
      "cli": {
        "argv": [
          "publish",
          "--repo",
          "<repo>",
          "--branch",
          "main",
          "--remote",
          "origin",
          "--revision",
          "<revision>",
          "--forge",
          "gitea",
          "--account",
          "owner",
          "--target",
          "main",
          "--title",
          "Checked publish",
          "--body",
          "",
          "--output-budget",
          "65536"
        ],
        "expectedExit": 20,
        "expectedError": "unsupported",
        "cancellation": "none"
      },
      "mcpTool": "agent_publish",
      "mcpConfiguration": "gitea-git",
      "mcpArguments": {
        "branch": "main",
        "remote": "origin",
        "revision": "<revision>",
        "account": "owner",
        "target": "main",
        "title": "Checked publish",
        "body": ""
      },
      "mcpTransportOutcome": "call-tool-result",
      "operation": "publish",
      "status": "error",
      "terminal": true,
      "errorCode": "unsupported",
      "expectedExit": 20
    },
    {
      "id": "cancellation",
      "cli": {
        "argv": [
          "commit",
          "--repo",
          "<repo>",
          "--path",
          "a.txt",
          "--message",
          "Selected paths",
          "--output-budget",
          "65536"
        ],
        "expectedExit": 27,
        "expectedError": "cancellation",
        "cancellation": "pre-cancelled"
      },
      "mcpTool": "agent_commit",
      "mcpConfiguration": "cancellation-git",
      "mcpArguments": {
        "paths": [
          "a.txt"
        ],
        "message": "Selected paths"
      },
      "mcpTransportOutcome": "request-cancelled",
      "operation": "commit",
      "status": "error",
      "terminal": true,
      "errorCode": "cancellation",
      "expectedExit": 27
    },
    {
      "id": "output-limit",
      "cli": {
        "argv": [
          "changes",
          "--repo",
          "<repo>",
          "--view",
          "summary",
          "--output-budget",
          "512"
        ],
        "expectedExit": 28,
        "expectedError": "output-limit",
        "cancellation": "none"
      },
      "mcpTool": "agent_changes",
      "mcpConfiguration": "large-changes-git",
      "mcpArguments": {
        "view": "summary"
      },
      "mcpTransportOutcome": "call-tool-result",
      "operation": "changes",
      "status": "error",
      "terminal": true,
      "errorCode": "output-limit",
      "expectedExit": 28
