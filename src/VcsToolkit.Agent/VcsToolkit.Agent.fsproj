<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>VcsToolkit.Agent</AssemblyName>
		<PackageId>VcsToolkit.Agent</PackageId>
		<Description>Transport-neutral, versioned outcome contracts for agent-facing VCS workflows. Provides bounded machine-readable envelopes and reusable orchestration over VcsToolkit.Core and VcsToolkit.Forge, with no raw-command escape hatch.</Description>
		<PackageTags>fsharp;vcs;git;jujutsu;jj;forge;agent;automation;process</PackageTags>
		<AssemblySearchPaths>$(AssemblySearchPaths);$(CoreDir)bin\$(Configuration)\$(TargetFramework);$(ForgeDir)bin\$(Configuration)\$(TargetFramework);$(CliSupportDir)bin\$(Configuration)\$(TargetFramework)</AssemblySearchPaths>
	</PropertyGroup>

	<!-- F# COMPILE ORDER IS SIGNIFICANT. -->
	<ItemGroup>
		<Compile Include="Contract.fs" />
		<Compile Include="Redaction.fs" />
		<Compile Include="Agent.fs" />
		<Compile Include="Wire.fs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="VcsToolkit.Agent.Tests" />
		<InternalsVisibleTo Include="vcs-agent" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FSharp.Core" />
		<PackageReference Include="ProcessKit" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="VcsToolkit.Core" />
		<Reference Include="VcsToolkit.Forge" />
		<Reference Include="VcsToolkit.CliSupport" />
	</ItemGroup>

</Project>
