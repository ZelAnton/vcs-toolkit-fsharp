<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>vcs-agent</AssemblyName>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>vcs-agent</ToolCommandName>
		<PackageId>vcs-agent</PackageId>
		<Description>The outcome-oriented VcsToolkit agent interface as a .NET global tool. Emits bounded, versioned JSON results and composes typed VcsToolkit.Core and VcsToolkit.Forge operations without a raw-command escape hatch.</Description>
		<PackageTags>fsharp;vcs;git;jujutsu;jj;forge;agent;automation;dotnet-tool</PackageTags>
		<AssemblySearchPaths>$(AssemblySearchPaths);$(AgentDir)bin\$(Configuration)\$(TargetFramework);$(CoreDir)bin\$(Configuration)\$(TargetFramework);$(ForgeDir)bin\$(Configuration)\$(TargetFramework);$(CliSupportDir)bin\$(Configuration)\$(TargetFramework)</AssemblySearchPaths>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Program.fs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="VcsToolkit.Agent.Server.Tests" />
		<InternalsVisibleTo Include="VcsToolkit.Mcp.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FSharp.Core" />
		<PackageReference Include="ProcessKit" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="VcsToolkit.Agent" />
		<Reference Include="VcsToolkit.Core" />
		<Reference Include="VcsToolkit.Forge" />
		<Reference Include="VcsToolkit.CliSupport" />
	</ItemGroup>

</Project>
